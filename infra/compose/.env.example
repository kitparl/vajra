# Copy to .env (git-ignored) and replace every change-me value.
# Image tags live ONLY here; compose, tests and CI read them from this file/env.
POSTGRES_IMAGE=postgres:18.7-alpine3.23
KAFKA_IMAGE=apache/kafka:4.4.0
REDIS_IMAGE=redis:8.8.4-alpine

POSTGRES_PASSWORD=change-me
CORE_DB_PASSWORD=change-me-core
RISK_DB_PASSWORD=change-me-risk
GATEWAY_DB_PASSWORD=change-me-gateway
RESEARCH_DB_PASSWORD=change-me-research
SIGNAL_DB_PASSWORD=change-me-signal
RISK_API_TOKEN=change-me-risk-api-token
CORE_INTERNAL_TOKEN=change-me-core-internal-token
KAFKA_BOOTSTRAP=kafka:9092
# Heartbeat strategy tick (signal-service); minimum 10. Override in the shell for demos, do not change here.
HEARTBEAT_INTERVAL_SECONDS=900
